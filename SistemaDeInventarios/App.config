<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<connectionStrings>
		<!-- Bases de datos aqui-->
		<add name="ConexionSQL"
		connectionString="Data Source=MSI\SQLSERVER;Initial Catalog=SistemaInventarios;Integrated Security=True;Connect Timeout=30;Encrypt=True;TrustServerCertificate=True;ApplicationIntent=ReadWrite;MultiSubnetFailover=False;"
		providerName="System.Data.SqlClient"/>
	</connectionStrings>
</configuration>
